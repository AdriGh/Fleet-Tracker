# Variables de entorno del backend DVIR. Copiar a `.env` y ajustar.
# En desarrollo no hace falta setear nada: se usa una SQLite local.

# Motor de base de datos.
#   - Produccion (nube): apuntar a una Postgres.
#       DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/dvir
#   - Dev/tests: dejar sin setear -> cae a SQLite local (backend/dvir.db).
# DATABASE_URL=postgresql+psycopg://dvir:dvir@localhost:5432/dvir

# Host/puerto del servidor. En la nube suele ser 0.0.0.0 y el puerto que
# asigne el hosting.
# DVIR_HOST=127.0.0.1
# DVIR_PORT=8765

# Backend de secretos (token de auth, integraciones). 'file' = archivos
# *.local.json locales (default). H8 podra enchufar un secrets manager.
# SECRETS_BACKEND=file
